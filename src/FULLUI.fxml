<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="MainController"
            prefWidth="1100"
            prefHeight="700">

    <left>
        <VBox spacing="10" prefWidth="180" style="-fx-background-color: #20242b;">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <Label text="Campus Event System"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Button text="Users" onAction="#showUsers" maxWidth="Infinity"/>
            <Button text="Events" onAction="#showEvents" maxWidth="Infinity"/>
            <Button text="Bookings" onAction="#showBookings" maxWidth="Infinity"/>
            <Button text="Waitlist" onAction="#showWaitlist" maxWidth="Infinity"/>
            <Button text="Save Data" onAction="#handleSave" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" style="-fx-background-color: #f4f6f8;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>


            <VBox fx:id="panelUsers" spacing="12" visible="false" managed="false">
                <Label text="User Management" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <HBox spacing="10">
                    <TextField fx:id="txtUserId" promptText="User ID"/>
                    <TextField fx:id="txtUserName" promptText="Name"/>
                    <TextField fx:id="txtUserEmail" promptText="Email"/>
                    <ComboBox fx:id="cmbUserType" promptText="User Type" prefWidth="140"/>
                    <Button text="Add User" onAction="#handleAddUser"/>
                </HBox>

                <TableView fx:id="tblUsers" prefHeight="500">
                    <columns>
                        <TableColumn fx:id="colUserId" text="User ID" prefWidth="120"/>
                        <TableColumn fx:id="colUserName" text="Name" prefWidth="220"/>
                        <TableColumn fx:id="colUserEmail" text="Email" prefWidth="260"/>
                        <TableColumn fx:id="colUserType" text="Type" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="panelEvents" spacing="12" visible="false" managed="false">
                <Label text="Event Management" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <HBox spacing="10">
                    <TextField fx:id="txtEventId" promptText="Event ID"/>
                    <TextField fx:id="txtEventTitle" promptText="Title"/>
                    <TextField fx:id="txtEventDate" promptText="Date/Time"/>
                    <TextField fx:id="txtEventLocation" promptText="Location"/>
                </HBox>

                <HBox spacing="10">
                    <TextField fx:id="txtEventCapacity" promptText="Capacity"/>
                    <ComboBox fx:id="cmbEventType" promptText="Event Type" prefWidth="140"/>
                    <TextField fx:id="txtEventSpecific" promptText="Topic / Speaker / Age Restriction"/>
                    <Button text="Create Event" onAction="#handleCreateEvent"/>
                    <Button text="Cancel Selected Event" onAction="#handleCancelEvent"/>
                </HBox>

                <HBox spacing="10">
                    <TextField fx:id="txtSearchTitle" promptText="Search by title"/>
                    <ComboBox fx:id="cmbFilterType" promptText="Filter Type" prefWidth="140"/>
                    <Button text="Search" onAction="#handleSearchEvents"/>
                    <Button text="Clear" onAction="#handleClearSearch"/>
                </HBox>

                <TableView fx:id="tblEvents" prefHeight="420">
                    <columns>
                        <TableColumn fx:id="colEventId" text="Event ID" prefWidth="90"/>
                        <TableColumn fx:id="colEventTitle" text="Title" prefWidth="180"/>
                        <TableColumn fx:id="colEventDate" text="Date/Time" prefWidth="160"/>
                        <TableColumn fx:id="colEventLocation" text="Location" prefWidth="140"/>
                        <TableColumn fx:id="colEventCapacity" text="Capacity" prefWidth="90"/>
                        <TableColumn fx:id="colEventStatus" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="colEventType" text="Type" prefWidth="110"/>
                    </columns>
                </TableView>
            </VBox>
