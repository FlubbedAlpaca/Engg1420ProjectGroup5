<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="MainController"
            prefWidth="1100"
            prefHeight="700">

    <left>
        <VBox spacing="10" prefWidth="180" style="-fx-background-color: #20242b;">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <Label text="Campus Event System"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Button text="Users" onAction="#showUsers" maxWidth="Infinity"/>
            <Button text="Events" onAction="#showEvents" maxWidth="Infinity"/>
            <Button text="Bookings" onAction="#showBookings" maxWidth="Infinity"/>
            <Button text="Waitlist" onAction="#showWaitlist" maxWidth="Infinity"/>
            <Button text="Save Data" onAction="#handleSave" maxWidth="Infinity"/>
        </VBox>
    </left>
